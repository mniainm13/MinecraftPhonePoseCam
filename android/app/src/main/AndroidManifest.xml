<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- AR is optional: non-ARCore devices fall back to pure IMU (OrientationFusion). -->
    <uses-feature android:name="android.hardware.camera.ar" android:required="false" />
    <uses-feature android:glEsVersion="0x00030001" android:required="true" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.PhoneCam"
        android:usesCleartextTraffic="true">
        <!-- optional: do not force Play Store filter; runtime still prefers ARCore when available -->
        <meta-data
            android:name="com.google.ar.core"
            android:value="optional" />
        <!-- Pin ~ARCore 1.40: newer VIO can be jankier on relative pose (arcore-android-sdk#1768) -->
        <meta-data
            android:name="com.google.ar.core.min_apk_version"
            android:value="180000000"
            tools:replace="android:value"
            xmlns:tools="http://schemas.android.com/tools" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ViewfinderActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <activity
            android:name=".CropEditActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.PhoneCam" />
        <activity
            android:name=".ArDebugActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
    </application>
</manifest>
