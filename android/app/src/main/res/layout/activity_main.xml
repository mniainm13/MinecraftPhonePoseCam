<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <eightbitlab.com.blurview.BlurTarget
        android:id="@+id/blurTarget"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <android.opengl.GLSurfaceView
            android:id="@+id/viewfinderGl"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </eightbitlab.com.blurview.BlurTarget>

    <!-- TOP BAR outside BlurTarget so clicks always work -->
    <FrameLayout
        android:id="@+id/topChrome"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnExpand"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center"
            android:background="@null"
            android:contentDescription="设置"
            android:src="@drawable/ic_chevron_down"
            app:tint="#E8EEF8" />
    </FrameLayout>

    <TextView
        android:id="@+id/textPose"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#66000000"
        android:fontFamily="monospace"
        android:padding="6dp"
        android:textColor="#7DDEA2"
        android:textSize="11sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topChrome"
        tools:text="转向 yaw=0" />

    <!-- SETTINGS card -->
    <dev.phonecam.app.ui.FrostBlurView
        android:id="@+id/settingsPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottomChrome"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topChrome">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/settingsScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="14dp"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/statusDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/dot_offline" />

                <TextView
                    android:id="@+id/textStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="未连接"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    tools:text="推流 10.0.0.1:42424" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="连接"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/SettingsField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="PC IP"
                app:boxBackgroundMode="outline">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputHost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/SettingsField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="位姿端口"
                app:boxBackgroundMode="outline">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputPort"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:text="42424"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="显示详情数据"
                android:textColor="#FFFFFF"
                app:thumbTint="#FFFFFF"
                app:trackTint="#66FFFFFF" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchBlur"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="磨砂模糊"
                android:textColor="#FFFFFF"
                app:thumbTint="#FFFFFF"
                app:trackTint="#66FFFFFF" />

            <TextView
                android:id="@+id/labelBlurFps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="模糊帧率 20 fps"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <com.google.android.material.slider.Slider
                android:id="@+id/seekBlurFps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stepSize="5"
                android:value="20"
                android:valueFrom="10"
                android:valueTo="60"
                app:thumbColor="#FFFFFF"
                app:trackColorActive="#FFFFFF"
                app:trackColorInactive="#4DFFFFFF" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="裁切模式"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/groupCropMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCropPortrait"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="竖屏"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCropLandscape"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="横屏"
                    android:textSize="13sp" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <LinearLayout
                android:id="@+id/rowLandscapeFlip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="方向"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/groupLandscapeFlip"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFlipOff"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="正向"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFlipOn"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="180° 反向"
                        android:textSize="13sp" />
                </com.google.android.material.button.MaterialButtonToggleGroup>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="画幅"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipFrame"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:chipSpacingHorizontal="6dp"
                    app:selectionRequired="true"
                    app:singleLine="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFrameFull"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="全幅"
                        android:textSize="12sp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFrame11"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1:1"
                        android:textSize="12sp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFrame34"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3:4"
                        android:textSize="12sp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFrame169"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="16:9"
                        android:textSize="12sp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFrameCinema"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="遮幅电影"
                        android:textSize="12sp" />
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchInvertY"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="反转 Y 轴"
                android:textColor="#FFFFFF"
                app:thumbTint="#FFFFFF"
                app:trackTint="#66FFFFFF" />

            <TextView
                android:id="@+id/labelSens"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="灵敏度 ×1.0"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <com.google.android.material.slider.Slider
                android:id="@+id/seekSensitivity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:value="1.0"
                android:valueFrom="0.1"
                android:valueTo="3.0"
                app:thumbColor="#FFFFFF"
                app:trackColorActive="#FFFFFF"
                app:trackColorInactive="#4DFFFFFF" />

            <TextView
                android:id="@+id/labelPosSens"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="位移灵敏度 ×1.0（自由模式）"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <com.google.android.material.slider.Slider
                android:id="@+id/seekPosSens"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:enabled="false"
                android:value="1.0"
                android:valueFrom="0.1"
                android:valueTo="4.0"
                app:thumbColor="#FFFFFF"
                app:trackColorActive="#FFFFFF"
                app:trackColorInactive="#4DFFFFFF" />

            <TextView
                android:id="@+id/labelBitrate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="推流码率 12 Mbps"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <com.google.android.material.slider.Slider
                android:id="@+id/seekBitrate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stepSize="1"
                android:value="12"
                android:valueFrom="2"
                android:valueTo="40"
                app:thumbColor="#FFFFFF"
                app:trackColorActive="#FFFFFF"
                app:trackColorInactive="#4DFFFFFF" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="缩放范围"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/SettingsField"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:hint="下限"
                    app:boxBackgroundMode="outline">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputZoomMin"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:text="0.25"
                        android:textColor="#E8EEF8"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/SettingsField"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="上限"
                    app:boxBackgroundMode="outline">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputZoomMax"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:text="4.0"
                        android:textColor="#E8EEF8"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="变焦挡位（长按删除 · 自动排序）"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupPresets"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:chipSpacingHorizontal="4dp"
                    app:selectionRequired="true"
                    app:singleLine="true"
                    app:singleSelection="true" />
            </HorizontalScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/SettingsField"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="新挡位，如 1.5"
                    app:boxBackgroundMode="outline">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputNewPreset"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:textColor="#E8EEF8"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddPreset"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="添加"
                    app:backgroundTint="#80FFFFFF"
                    android:textColor="#0B1220" />
            </LinearLayout>

            <TextView
                android:id="@+id/labelZoom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="当前缩放 ×1.00"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <com.google.android.material.slider.Slider
                android:id="@+id/seekZoom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:value="0.5"
                android:valueFrom="0"
                android:valueTo="1"
                app:thumbColor="#FFFFFF"
                app:trackColorActive="#FFFFFF"
                app:trackColorInactive="#4DFFFFFF" />

            <TextView
                android:id="@+id/labelBottomUi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="底部 UI 距底 ×1.0"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <com.google.android.material.slider.Slider
                android:id="@+id/seekBottomUi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:value="1.0"
                android:valueFrom="0.4"
                android:valueTo="2.0"
                app:thumbColor="#FFFFFF"
                app:trackColorActive="#FFFFFF"
                app:trackColorInactive="#4DFFFFFF" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnArDebug"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="AR 调试"
                android:textColor="#FFFFFF" />
        </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </dev.phonecam.app.ui.FrostBlurView>

    <!-- BOTTOM -->
    <LinearLayout
        android:id="@+id/bottomChrome"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <dev.phonecam.app.ui.FrostBlurView
            android:id="@+id/blurZoom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal">

            <dev.phonecam.app.ui.ZoomPillBar
                android:id="@+id/zoomPill"
                android:layout_width="wrap_content"
                android:layout_height="44dp" />
        </dev.phonecam.app.ui.FrostBlurView>

        <dev.phonecam.app.ui.FrostBlurView
            android:id="@+id/blurMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp">

            <dev.phonecam.app.ui.ModePillBar
                android:id="@+id/modePill"
                android:layout_width="wrap_content"
                android:layout_height="40dp" />
        </dev.phonecam.app.ui.FrostBlurView>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <dev.phonecam.app.ui.FrostBlurView
                android:id="@+id/blurCal"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true">

                <ImageButton
                    android:id="@+id/btnCalibrate"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:contentDescription="校准"
                    android:src="@drawable/ic_target"
                    app:tint="#E8EEF8" />
            </dev.phonecam.app.ui.FrostBlurView>

            <FrameLayout
                android:id="@+id/btnShutter"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_centerInParent="true">

                <View
                    android:id="@+id/shutterRing"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/shutter_ring" />

                <View
                    android:id="@+id/shutterCore"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_gravity="center"
                    android:background="@drawable/shutter_core_idle" />
            </FrameLayout>

            <dev.phonecam.app.ui.FrostBlurView
                android:id="@+id/blurSheet"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true">

                <ImageButton
                    android:id="@+id/btnSheet"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:contentDescription="全屏取景"
                    android:src="@drawable/ic_expand"
                    app:tint="#E8EEF8" />
            </dev.phonecam.app.ui.FrostBlurView>
        </RelativeLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
