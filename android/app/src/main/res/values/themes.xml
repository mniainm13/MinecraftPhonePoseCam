<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PhoneCam" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">#3D7EFF</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">#7A5CFF</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">#000000</item>
        <item name="android:colorBackground">#000000</item>
        <item name="android:textColor">#E8EEF8</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <style name="FabCircle" parent="">
        <item name="cornerSize">50%</item>
    </style>

    <!-- Settings field — no stroke, soft black fill, high-contrast text -->
    <style name="SettingsField" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeColor">@android:color/transparent</item>
        <item name="boxBackgroundColor">#33000000</item>
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="hintTextColor">#FFFFFF</item>
        <item name="android:textColorHint">#FFFFFF</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>
</resources>
